# ---------------------------------------------------------------------------
# ClearCut configuration
#
# Copy to .env and fill in. .env is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# Master passphrase that unlocks the encrypted API keys below.
# Generate one with:  npm run encrypt-key -- --generate
# In production, set this through your host's secret manager rather than a file,
# so the passphrase and the ciphertext are never stored in the same place.
KEY_ENCRYPTION_SECRET=

# Encrypted PhotoRoom keys. Produce these with:
#   npm run encrypt-key
# The plaintext key is never stored — only the AES-256-GCM blob below.
PHOTOROOM_API_KEY_ENC=
PHOTOROOM_SANDBOX_API_KEY_ENC=

# "live" bills against your PhotoRoom quota and returns clean cutouts.
# "sandbox" is free and returns watermarked previews — use it while developing.
PHOTOROOM_MODE=live

# --- Optional tuning ------------------------------------------------------
PORT=3000
MAX_UPLOAD_MB=12
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=30
PHOTOROOM_TIMEOUT_MS=60000
